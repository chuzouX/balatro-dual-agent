# TypeSafe AI Jev API Key
TYPESAFE_API_KEY=your_typesafe_api_key_here
# Jev 网络代理设置 (支持 HTTP/SOCKS5，例如 socks5://127.0.0.1:12450 或 http://127.0.0.1:7890；留空则直连)
JEV_PROXY_URL=

# DeepSeek API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DeepSeek 强制直连 (true = 强制绕过任何代理，国内节点低延迟直连)
DEEPSEEK_DIRECT=true

# Balatro Game / API Server Configuration
BALATRO_HOST=127.0.0.1
BALATRO_PORT=12346
BALATRO_EXE=E:\Games\Balatro\Balatro.exe

# Bot Options
AUTO_LAUNCH_GAME=true
HEADLESS=false
STEP_DELAY_MS=1200
